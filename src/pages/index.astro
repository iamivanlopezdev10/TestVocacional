---
import Layout from '../layouts/Layout.astro';
import TestVocacional from '../components/TestVocacional.jsx';
---

<Layout title="Test Vocacional TecTux">
	<main>
		<div className="app-container">
			<TestVocacional client:load />
		</div>
	</main>
</Layout>

<style is:global>
	/* --- RESET GENERAL --- */
	:root {
		--primary: #003366; /* Azul TecTux */
		--accent: #d4af37;  /* Dorado */
		--bg: #f0f4f8;      /* Gris azulado muy tenue */
		--text: #333;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		background-color: var(--bg);
		color: var(--text);
		font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		min-height: 100vh;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 20px;
	}

	main {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.app-container {
		width: 100%;
		max-width: 550px; /* Ancho máximo de la tarjeta */
		display: flex;
		justify-content: center;
	}

	/* --- ESTILOS DE LA TARJETA (Los mismos de antes, pero ordenados) --- */
	.card {
		background: white;
		padding: 3rem 2rem;
		border-radius: 24px;
		box-shadow: 0 15px 35px rgba(0,0,0,0.08);
		width: 100%;
		text-align: center;
		border: 1px solid rgba(0,0,0,0.03);
	}

	.title { 
		color: var(--primary); 
		margin-bottom: 0.5rem; 
		font-size: 2.2rem;
		font-weight: 800;
	}

	.subtitle {
		color: #666;
		margin-bottom: 2.5rem;
		font-size: 1.1rem;
	}

	/* --- ESTILOS DE FORMULARIO --- */
	.form-group {
		margin-bottom: 1.5rem;
	}

	.form-group input {
		width: 100%;
		padding: 15px;
		margin: 10px 0;
		border: 2px solid #eee;
		border-radius: 12px;
		font-size: 1rem;
		transition: border-color 0.2s;
	}

	.form-group input:focus {
		outline: none;
		border-color: var(--primary);
	}

	.row { 
		display: flex; 
		gap: 15px; 
	}

	/* --- BOTONES --- */
	.btn-main {
		background: var(--primary);
		color: white;
		border: none;
		padding: 18px 30px;
		border-radius: 14px;
		font-weight: bold;
		font-size: 1.1rem;
		cursor: pointer;
		width: 100%;
		margin-top: 10px;
		transition: all 0.2s;
		box-shadow: 0 4px 10px rgba(0,51,102,0.2);
	}

	.btn-main:hover:not(:disabled) { 
		transform: translateY(-2px); 
		background: #002244; 
		box-shadow: 0 6px 15px rgba(0,51,102,0.3);
	}

	.btn-main:disabled {
		background: #ccc;
		cursor: not-allowed;
		box-shadow: none;
	}

	/* --- PROGRESO Y OPCIONES --- */
	.progress-container {
		background: #eee;
		height: 10px;
		border-radius: 5px;
		margin-bottom: 25px;
		overflow: hidden;
	}

	.progress-bar {
		background: var(--accent);
		height: 100%;
		border-radius: 5px;
		transition: width 0.4s ease;
	}

	.question-count {
		color: #888;
		font-size: 0.9rem;
		margin-bottom: 10px;
	}

	.question-text {
		font-size: 1.5rem;
		color: var(--primary);
		margin-bottom: 2rem;
		line-height: 1.3;
	}

	.options {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.btn-option {
		width: 100%;
		padding: 16px;
		background: white;
		border: 2px solid #ddd;
		color: var(--text);
		border-radius: 12px;
		cursor: pointer;
		font-weight: 600;
		font-size: 1.05rem;
		transition: all 0.2s;
	}

	.btn-option:hover {
		border-color: var(--accent);
		background: rgba(212, 175, 55, 0.05);
	}

	.btn-option:active {
		transform: scale(0.98);
	}

	/* --- RESULTADO --- */
	.result-card h2 { color: var(--primary); font-size: 2rem; }
	
	.badge {
		font-size: 2.2rem;
		font-weight: 800;
		color: var(--accent);
		background: var(--primary);
		margin: 25px 0;
		padding: 15px 30px;
		border-radius: 15px;
		display: inline-block;
		box-shadow: 0 5px 15px rgba(0,0,0,0.1);
	}
</style>